{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++17: build, debug and use terminal input (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/build/program",
      "cwd": "${fileDirname}",
      "args": [],
      "terminal": "integrated",
      "preLaunchTask": "C++17: build active file",
      "stopOnEntry": false
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "gdb",
      "request": "launch",
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "target": "${workspaceFolder}/build/Debug/outDebug",
      "gdbpath": "gdb",
      "valuesFormatting": "prettyPrinters"
    }
  ]
}
