{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++17: build, debug and use terminal input (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/build/program",
      "cwd": "${fileDirname}",
      "args": [],
      "terminal": "integrated",
      "preLaunchTask": "C++17: build active file",
      "stopOnEntry": false
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/alex/projects/YandexHandbookCpp",
      "program": "/home/alex/projects/YandexHandbookCpp/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
